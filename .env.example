# Groq API Key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Postgres connection string (Render: use the External URL locally, Internal URL on Render)
# Local docker-compose: postgres://dreams:dreams@localhost:5432/dreams
DATABASE_URL=postgres://user:password@host:5432/dbname

# Server Port
PORT=3001
