# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Postgres connection string (Render: use the External URL locally, Internal URL on Render)
# Local docker-compose: postgres://dreams:dreams@localhost:5432/dreams
DATABASE_URL=postgres://user:password@host:5432/dbname

# Server Port
PORT=3001
